@@ -0,0 +1,19 @@
+import type { Component } from "./tui.ts";
+
+export interface ScrollRowSource {
+    readonly rowCount: number;
+    rows(start: number, count: number): readonly string[];
+}
+
+export interface ScrollContent extends Component {
+    scrollRows(width: number): ScrollRowSource;
+}
+
+export type ScrollRows = readonly string[] | ScrollRowSource;
+
+export declare const SCROLL_ROW_CHUNK_SIZE = 256;
+export declare const SCROLL_RENDER_OVERSCAN_ROWS = 2;
+export declare function getScrollRowCount(source: ScrollRows): number;
+export declare function readScrollRows(source: ScrollRows, start: number, count: number): readonly string[];
+export declare function readScrollRow(source: ScrollRows, row: number): string | undefined;
+export declare function getComponentScrollRowSource(component: Component, width: number): ScrollRowSource | undefined;
diff --git a/dist/scroll-row-source.js b/dist/scroll-row-source.js
new file mode 100644
index 0000000000000000000000000000000000000000..3890b3cbab4d3350ca555f59e7d6dccd8369fead
--- /dev/null
+++ b/dist/scroll-row-source.js
@@ -0,0 +1,45 @@
+export const SCROLL_ROW_CHUNK_SIZE = 256;
+export const SCROLL_RENDER_OVERSCAN_ROWS = 2;
+
+function normalizeRangeValue(value) {
+    return Number.isFinite(value) ? Math.max(0, Math.floor(value)) : 0;
+}
+
+export function getScrollRowCount(source) {
+    if (Array.isArray(source))
+        return source.length;
+    const rowCount = source?.rowCount;
+    if (!Number.isSafeInteger(rowCount) || rowCount < 0)
+        throw new Error("ScrollRowSource rowCount must be an exact non-negative safe integer");
+    return rowCount;
+}
+
+export function readScrollRows(source, start, count) {
+    const rowCount = getScrollRowCount(source);
+    const safeStart = Math.min(rowCount, normalizeRangeValue(start));
+    const safeCount = Math.min(rowCount - safeStart, normalizeRangeValue(count));
+    if (Array.isArray(source))
+        return source.slice(safeStart, safeStart + safeCount);
+    const rows = source.rows(safeStart, safeCount);
+    if (!Array.isArray(rows))
+        throw new Error("ScrollRowSource rows() must return an array");
+    if (rows.length !== safeCount)
+        throw new Error(`ScrollRowSource rows() must return exactly ${safeCount} rows`);
+    if (rows.some((row) => typeof row !== "string"))
+        throw new Error("ScrollRowSource rows() must return only strings");
+    return rows;
+}
+
+export function readScrollRow(source, row) {
+    const safeRow = normalizeRangeValue(row);
+    return safeRow >= getScrollRowCount(source) ? undefined : readScrollRows(source, safeRow, 1)[0];
+}
+
+export function getComponentScrollRowSource(component, width) {
+    const provider = component;
+    if (typeof provider.scrollRows !== "function")
+        return undefined;
+    const source = provider.scrollRows(Math.max(1, Math.floor(width)));
+    getScrollRowCount(source);
+    return source;
+}
