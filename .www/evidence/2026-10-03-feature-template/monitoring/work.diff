+		git.staged > 0 ? `+${git.staged}` : "",
+		git.unstaged > 0 ? `*${git.unstaged}` : "",
+		git.untracked > 0 ? `?${git.untracked}` : "",
+	].filter(Boolean).join(" ");
+	return `${git.branch ?? "HEAD"}${changes ? ` ${changes}` : ""}`;
+}
