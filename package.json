{
	"name": "world-wide-woo",
	"version": "0.0.24",
	"private": true,
	"type": "module",
	"bin": {
		"www": "./src/cli.ts"
	},
	"scripts": {
		"project-view:dev": "npm --prefix apps/project-view run dev",
		"project-view:build": "npm --prefix apps/project-view run build",
		"project-view:check": "npm --prefix apps/project-view run check",
		"project-view:test": "npm --prefix apps/project-view test",
		"start": "bun src/cli.ts",
		"build": "bun build src/cli.ts --target=bun --outdir dist",
		"www:preview": "bun scripts/www-ui-preview.ts",
		"check": "tsc --noEmit",
		"test": "bun test",
		"release:gate": "bun scripts/release-gate.ts",
		"traceability:check": "bun scripts/traceability.ts check --linear-snapshot .www/evidence/v020-traceability/linear-consistency-final-normalized.json --linear-receipt .www/evidence/v020-traceability/linear-consistency-final-receipt.json --vault-export-manifest .www/evidence/v020-traceability/obsidian-export-manifest.json",
		"traceability:rebuild": "bun scripts/traceability.ts rebuild",
		"development-map:build": "bun scripts/traceability.ts map:build",
		"development-map:check": "bun scripts/traceability.ts map:check",
		"feature-map:build": "bun scripts/feature-map.ts build",
		"feature-map:check": "bun scripts/feature-map.ts check",
		"obsidian:check": "bun src/adapters/outbound/development/obsidian-contract-cli.ts check",
		"obsidian:sync": "bun src/adapters/outbound/development/obsidian-contract-cli.ts",
		"units:check": "bun scripts/local-units.ts check",
		"units:sync": "bun scripts/local-units.ts sync",
		"commit:control": "bun scripts/woo-commit.ts",
		"commit:hooks:install": "bun scripts/install-commit-hooks.ts",
		"commit:agent-hook": "bun scripts/woo-agent-hook.ts",
		"recording:hook": "bun scripts/work-recording-hook.ts",
		"commit:receipts:rebuild": "bun scripts/woo-receipts.ts rebuild",
		"artifact:control": "bun scripts/artifact-control.ts",
		"rpa:description": "bun scripts/rpa-description.ts",
		"skill:runtime": "bun scripts/skill-runtime.ts",
		"traceability:receipt-check": "bun scripts/traceability.ts receipt-check --linear-snapshot .www/evidence/v020-traceability/linear-consistency-final-normalized.json --linear-receipt .www/evidence/v020-traceability/linear-consistency-final-receipt.json --vault-export-manifest .www/evidence/v020-traceability/obsidian-export-manifest.json"
	},
	"dependencies": {
		"@openai/codex": "0.160.0",
		"@earendil-works/pi-ai": "0.84.4",
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@earendil-works/pi-tui": "0.84.4",
		"@gajae-code/ai": "0.15.6",
		"@gajae-code/natives": "0.15.6",
		"chalk": "5.6.2",
		"open": "10.2.0",
		"typebox": "1.3.7",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/bun": "1.4.0",
		"typescript": "7.0.2"
	},
	"patchedDependencies": {
		"@earendil-works/pi-tui@0.84.4": "patches/@earendil-works__pi-tui@0.84.4.patch"
	}
}
