{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woo.local/schemas/commit-candidate.schema.json",
  "title": "Woo Commit Candidate",
  "type": "object",
  "required": ["schemaVersion", "id", "intent", "type", "scope", "baseHead", "contentDigest", "state", "decision", "result", "why", "paths", "axes", "validations", "boundaries", "refs", "blockers", "next"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^COMMIT-CANDIDATE-[A-Z0-9][A-Z0-9-]*$" },
    "intent": { "type": "string", "minLength": 1 },
    "type": { "enum": ["feat", "fix", "perf", "refactor", "test", "docs", "build", "ci", "chore", "revert"] },
    "scope": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "baseHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "contentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "impactedScopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "state": { "enum": ["complete", "checkpoint", "red", null] },
    "decision": { "enum": ["ready", "split", "not-ready"] },
    "result": { "type": "string", "minLength": 1 },
    "why": { "type": "string", "minLength": 1 },
    "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "axes": { "type": "object" },
    "validations": { "type": "array", "minItems": 1 },
    "boundaries": { "type": "array", "minItems": 1 },
    "refs": { "type": "array", "minItems": 1 },
    "blockers": { "type": "array" },
    "next": { "type": ["string", "null"] },
    "bodyRequired": { "type": "boolean" }
  },
  "additionalProperties": false
}
