#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
remote_name=${1:-origin}
baseline=$(git config --get woo.receiptBaseline || true)
test -n "$baseline" || { echo "woo-commit: BLOCKED — receipt baseline이 없습니다. bun run commit:hooks:install을 실행하세요." >&2; exit 2; }
while read local_ref local_sha remote_ref remote_sha; do
  test "$local_sha" = "0000000000000000000000000000000000000000" && continue
  if test "$remote_sha" = "0000000000000000000000000000000000000000"; then
    revisions=$(git rev-list "$local_sha" --not --remotes="$remote_name")
  else
    revisions=$(git rev-list "$remote_sha..$local_sha")
  fi
  for sha in $revisions; do
    test -f "$root/.www/receipts/commit/$sha.json" || { echo "woo-commit: BLOCKED — $sha Receipt가 없습니다." >&2; exit 2; }
  done
done
