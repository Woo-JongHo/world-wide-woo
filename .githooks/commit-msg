#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
active=$(git rev-parse --git-dir)/woo/active.json
candidate=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["candidatePath"])' "$active")
exec bun "$root/scripts/woo-commit.ts" hook commit-msg --root "$root" --candidate "$candidate" --message "$1"

